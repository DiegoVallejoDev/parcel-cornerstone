{
  "name": "parcel-cornerstone",
  "version": "1.0.0",
  "description": "A deterministic, zero-runtime static site architecture.",
  "author": "Diego Vallejo <DiegoVallejoDev>",
  "license": "MIT",
  "source": [
    "src/index.html",
    "src/*/index.html"
  ],
  "scripts": {
    "clean": "rimraf dist .parcel-cache",
    "setup:locales": "node scripts/setup-locales.js",
    "prestart": "npm run clean && npm run setup:locales",
    "start": "parcel src/index.html src/*/index.html --open",
    "prebuild": "npm run clean && npm run setup:locales",
    "build": "parcel build src/index.html src/*/index.html --no-source-maps --detailed-report 10"
  },
  "staticFiles": {
    "staticPath": "src/static",
    "staticOutDir": "api"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ],
  "dependencies": {
    "alpinejs": "^3.13.3",
    "htmx.org": "^1.9.10"
  },
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "^5.0.0",
    "autoprefixer": "^10.4.16",
    "parcel": "^2.11.0",
    "parcel-reporter-static-files-copy": "^1.5.3",
    "postcss": "^8.4.33",
    "posthtml": "^0.16.6",
    "posthtml-expressions": "^1.11.0",
    "posthtml-include": "^1.7.4",
    "rimraf": "^5.0.5"
  }
}
