{
  "name": "parcel-cornerstone",
  "version": "1.0.0",
  "description": "A hybrid static + serverless site template with build-time i18n.",
  "author": "Diego Vallejo <DiegoVallejoDev>",
  "license": "MIT",
  "source": [
    ".build/**/*.html",
    ".build/sitemap.xml"
  ],
  "scripts": {
    "clean": "rimraf dist .parcel-cache .build",
    "setup:locales": "node scripts/setup-locales.js",
    "prestart": "pnpm run clean && pnpm run setup:locales",
    "start": "parcel \".build/**/*.html\" \".build/sitemap.xml\" --open",
    "prebuild": "pnpm run clean && pnpm run setup:locales",
    "build": "parcel build \".build/**/*.html\" \".build/sitemap.xml\" --no-source-maps --detailed-report 10"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ],
  "dependencies": {
    "alpinejs": "^3.13.3"
  },
  "devDependencies": {
    "@parcel/compressor-brotli": "^2.11.0",
    "@parcel/compressor-gzip": "^2.11.0",
    "@parcel/config-default": "^2.11.0",
    "@parcel/packager-xml": "2.16.4",
    "@parcel/transformer-html": "^2.16.4",
    "@parcel/transformer-xml": "2.16.4",
    "@tailwindcss/postcss": "^4.1.18",
    "front-matter": "^4.0.2",
    "marked": "^17.0.3",
    "parcel": "^2.11.0",
    "parcel-transformer-cornerstone": "file:packages/parcel-transformer-cornerstone",
    "postcss": "^8.4.33",
    "rimraf": "^5.0.5",
    "tailwindcss": "^4.1.18"
  },
  "packageManager": "pnpm@10.30.0+sha512.2b5753de015d480eeb88f5b5b61e0051f05b4301808a82ec8b840c9d2adf7748eb352c83f5c1593ca703ff1017295bc3fdd3119abb9686efc96b9fcb18200937"
}
