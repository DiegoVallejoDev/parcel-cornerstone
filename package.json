{
  "name": "parcel-cornerstone",
  "version": "1.1.0",
  "description": "A hybrid static + serverless site template with build-time i18n.",
  "author": "Diego Vallejo <DiegoVallejoDev>",
  "license": "MIT",
  "source": [
    ".build/**/*.html",
    ".build/sitemap.xml",
    ".build/feed.xml"
  ],
  "scripts": {
    "clean": "rimraf dist .parcel-cache .build",
    "setup": "pnpm run clean && node scripts/setup-locales.js",
    "prestart": "pnpm run setup",
    "start": "parcel \".build/**/*.html\" \".build/sitemap.xml\" \".build/feed.xml\" --open",
    "prebuild": "pnpm run setup",
    "build": "parcel build \".build/**/*.html\" \".build/sitemap.xml\" \".build/feed.xml\" --no-source-maps --detailed-report 10",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,mjs,cjs,json,html,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs,json,html,css,md}\""
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.30.0+sha512.2b5753de015d480eeb88f5b5b61e0051f05b4301808a82ec8b840c9d2adf7748eb352c83f5c1593ca703ff1017295bc3fdd3119abb9686efc96b9fcb18200937",
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ],
  "dependencies": {
    "alpinejs": "^3.13.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@parcel/compressor-brotli": "^2.11.0",
    "@parcel/compressor-gzip": "^2.11.0",
    "@parcel/config-default": "^2.11.0",
    "@parcel/packager-xml": "2.16.4",
    "@parcel/transformer-html": "^2.16.4",
    "@parcel/transformer-xml": "2.16.4",
    "@tailwindcss/postcss": "^4.1.18",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "front-matter": "^4.0.2",
    "parcel": "^2.11.0",
    "parcel-transformer-cornerstone": "workspace:*",
    "postcss": "^8.4.33",
    "prettier": "^3.9.4",
    "rimraf": "^5.0.5",
    "tailwindcss": "^4.1.18"
  }
}
