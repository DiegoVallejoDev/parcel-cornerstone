{
  "extends": [
    "@parcel/config-default"
  ],
  "transformers": {
    "*.html": [
      "parcel-transformer-cornerstone",
      "@parcel/transformer-html"
    ]
  },
  "compressors": {
    "*.{html,css,js,svg,map}": [
      "...",
      "@parcel/compressor-gzip",
      "@parcel/compressor-brotli"
    ]
  }
}
