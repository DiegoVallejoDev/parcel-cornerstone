{
  "name": "parcel-cornerstone",
  "version": "1.0.0",
  "description": "A hybrid static + serverless site template with build-time i18n.",
  "author": "Diego Vallejo <DiegoVallejoDev>",
  "license": "MIT",
  "source": [
    ".build/index.html",
    ".build/*/index.html",
    ".build/404.html",
    ".build/*/404.html"
  ],
  "scripts": {
    "clean": "rimraf dist .parcel-cache .build",
    "setup:locales": "node scripts/setup-locales.js",
    "prestart": "pnpm run clean && pnpm run setup:locales",
    "start": "parcel .build/index.html .build/*/index.html .build/404.html .build/*/404.html --open",
    "prebuild": "pnpm run clean && pnpm run setup:locales",
    "build": "parcel build .build/index.html .build/*/index.html .build/404.html .build/*/404.html --no-source-maps --detailed-report 10"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ],
  "dependencies": {
    "alpinejs": "^3.13.3"
  },
  "devDependencies": {
    "@parcel/compressor-brotli": "^2.11.0",
    "@parcel/compressor-gzip": "^2.11.0",
    "@parcel/config-default": "^2.11.0",
    "@tailwindcss/postcss": "^4.1.18",
    "parcel": "^2.11.0",
    "postcss": "^8.4.33",
    "posthtml": "^0.16.6",
    "posthtml-expressions": "^1.11.0",
    "rimraf": "^5.0.5",
    "tailwindcss": "^4.1.18"
  }
}
